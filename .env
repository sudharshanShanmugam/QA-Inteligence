# ─── LLM (DeepInfra) ───────────────────────────────────────────────────────────
DEEPINFRA_API_KEY=80tQ18Dnwa9lb5eWExGQRoSUnotrQ1Km
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
EMBED_MODEL=BAAI/bge-large-en-v1.5
ENTITY_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ─── Graph DB ──────────────────────────────────────────────────────────────────
# Set USE_NEO4J=false to use the built-in NetworkX graph (no server needed)
USE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ─── Vector Store (ChromaDB) ───────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=qa_knowledge

# ─── Graph Persistence (NetworkX fallback) ─────────────────────────────────────
GRAPH_PERSIST_PATH=./backend/graph_data/qa_graph.pkl

# ─── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ─── Processing ────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_RETRIEVAL_DOCS=10
